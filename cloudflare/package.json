{
  "name": "waylens-accounts-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "check": "wrangler deploy --dry-run",
    "test": "wrangler deploy --dry-run --outdir .test-build && node --test tests/*.test.mjs",
    "predev": "python3 ../scripts/ops/build_assets.py",
    "predeploy": "python3 ../scripts/ops/build_assets.py",
    "precheck": "python3 ../scripts/ops/build_assets.py",
    "pretest": "python3 ../scripts/ops/build_assets.py"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "miniflare": "^4.0.0",
    "prettier": "^3.10.1",
    "wrangler": "^4.0.0"
  }
}
