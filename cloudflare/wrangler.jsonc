{
  "name": "hilex-accounts",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "../accounts/static",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hilex-accounts",
      "database_id": "d5fc96e2-d7d6-4d87-a2a9-24bd5d3d0e4f",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ACCOUNT_ORIGIN": "https://accounts.hilex.me",
    "API_HOST": "api.hilex.me",
    "LOCAL_MODELS_ENABLED": "false",
    "PROVIDER_DIAGNOSTICS_ENABLED": "true",
  },
  "routes": [{"pattern": "accounts.hilex.me", "custom_domain": true}, {"pattern":"api.hilex.me/*", "zone_name":"hilex.me"}],
  "observability": {"enabled": true, "logs": {"enabled": true, "invocation_logs": false}},
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
}
