# Load before starting the gateway. Model-serving may run on another private host.
ACCOUNTS_HOST=accounts.hilex.me
GATEWAY_API_HOST=api.hilex.me
LLM_UPSTREAM_URL=http://127.0.0.1:30007
ASR_UPSTREAM_URL=http://127.0.0.1:18767
TTS_UPSTREAM_URL=http://127.0.0.1:18768
EMBEDDING_UPSTREAM_URL=http://127.0.0.1:18771
VIBEVOICE_UPSTREAM_URL=http://127.0.0.1:18769
# GATEWAY_CLIENT_IDS_FILE=/absolute/path/to/client_ids.json
# ACCOUNTS_DATA=/absolute/path/to/accounts-data
# GATEWAY_BACKEND_CLIENT_ID=internal-service-id-from-model-serving
GATEWAY_LLM_CONCURRENCY=4
# Production defaults to Worker/D1. Missing configuration stops server startup.
GATEWAY_ACCOUNT_MODE=worker
ACCOUNTS_WORKER_URL=https://accounts.hilex.me
ACCOUNTS_WORKER_SECRET=
# For offline development only: GATEWAY_ACCOUNT_MODE=local

# Public API is authorized at the Worker; origin accepts only private edge handoffs.
GATEWAY_EDGE_ONLY=1
