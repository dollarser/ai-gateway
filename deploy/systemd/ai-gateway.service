[Unit]
Description=AI Gateway inference and account authorization
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10
[Service]
Environment="PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin"
Type=simple
WorkingDirectory=%h/workspace/ai-platform/ai-gateway
ExecStart=/bin/bash scripts/start.sh
Restart=always
RestartSec=5
TimeoutStopSec=930
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=default.target
